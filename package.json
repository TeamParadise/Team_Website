{
    "name": "team-paradise-website",
    "private": true,
    "packageManager": "pnpm@10.33.0",
    "scripts": {
        "check": "pnpm run check:html && pnpm run check:js && pnpm run check:site",
        "check:html": "html-validate \"index.html\" \"Pages/*.html\"",
        "check:js": "node --check Pages/site.js && node --check scripts/check-site.mjs",
        "check:site": "node scripts/check-site.mjs",
        "serve": "python3 -m http.server 4173"
    },
    "devDependencies": {
        "html-validate": "10.17.0"
    }
}
